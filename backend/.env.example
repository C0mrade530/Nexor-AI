# LifeOS Backend Configuration
# Copy to .env and fill in your values

LIFEOS_DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5432/lifeos
LIFEOS_REDIS_URL=redis://localhost:6379/0
LIFEOS_SECRET_KEY=your-secret-key-change-in-production

# AI Keys
LIFEOS_ANTHROPIC_API_KEY=sk-ant-...
LIFEOS_OPENAI_API_KEY=sk-...

# Optional: Deepgram for transcription
LIFEOS_TRANSCRIPTION_PROVIDER=openai_whisper
LIFEOS_DEEPGRAM_API_KEY=

# Privacy defaults
LIFEOS_AUDIO_RETENTION_POLICY=after_transcription
LIFEOS_AUDIO_RETENTION_DAYS=30
LIFEOS_ENCRYPT_AT_REST=true

# Google Calendar (OAuth)
LIFEOS_GOOGLE_CALENDAR_CLIENT_ID=
LIFEOS_GOOGLE_CALENDAR_CLIENT_SECRET=
