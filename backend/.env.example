# Nexor Backend Configuration
# Copy to .env and fill in your values

NEXOR_DATABASE_URL=postgresql+asyncpg://nexor:nexor@localhost:5432/nexor
NEXOR_REDIS_URL=redis://localhost:6379/0
NEXOR_SECRET_KEY=your-secret-key-change-in-production

# CometAPI — single gateway for Whisper + Claude
# Get your key at https://www.cometapi.com
NEXOR_COMETAPI_KEY=sk-your-cometapi-key
NEXOR_COMETAPI_BASE_URL=https://api.cometapi.com/v1

# Claude (via CometAPI — Anthropic Messages API compatible)
# If set, overrides cometapi_key for Claude calls
NEXOR_ANTHROPIC_BASE_URL=https://api.cometapi.com/v1
NEXOR_ANTHROPIC_API_KEY=
NEXOR_DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

# Whisper (via CometAPI — OpenAI-compatible)
# If set, overrides cometapi_key for Whisper calls
NEXOR_OPENAI_BASE_URL=https://api.cometapi.com/v1
NEXOR_OPENAI_API_KEY=
NEXOR_WHISPER_MODEL=whisper-1

# Transcription provider: "whisper" or "deepgram"
NEXOR_TRANSCRIPTION_PROVIDER=whisper

# Optional: Deepgram (if not using CometAPI Whisper)
NEXOR_DEEPGRAM_API_KEY=

# Privacy defaults
NEXOR_AUDIO_RETENTION_POLICY=after_transcription
NEXOR_AUDIO_RETENTION_DAYS=30
NEXOR_ENCRYPT_AT_REST=true

# Google Calendar (OAuth)
NEXOR_GOOGLE_CALENDAR_CLIENT_ID=
NEXOR_GOOGLE_CALENDAR_CLIENT_SECRET=
