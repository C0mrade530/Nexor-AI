# LifeOS Backend Configuration
# Copy to .env and fill in your values

LIFEOS_DATABASE_URL=postgresql+asyncpg://lifeos:lifeos@localhost:5432/lifeos
LIFEOS_REDIS_URL=redis://localhost:6379/0
LIFEOS_SECRET_KEY=your-secret-key-change-in-production

# CometAPI — single gateway for Whisper + Claude
# Get your key at https://www.cometapi.com
LIFEOS_COMETAPI_KEY=sk-your-cometapi-key
LIFEOS_COMETAPI_BASE_URL=https://api.cometapi.com/v1

# Claude (via CometAPI — Anthropic Messages API compatible)
# If set, overrides cometapi_key for Claude calls
LIFEOS_ANTHROPIC_BASE_URL=https://api.cometapi.com/v1
LIFEOS_ANTHROPIC_API_KEY=
LIFEOS_DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

# Whisper (via CometAPI — OpenAI-compatible)
# If set, overrides cometapi_key for Whisper calls
LIFEOS_OPENAI_BASE_URL=https://api.cometapi.com/v1
LIFEOS_OPENAI_API_KEY=
LIFEOS_WHISPER_MODEL=whisper-1

# Transcription provider: "whisper" or "deepgram"
LIFEOS_TRANSCRIPTION_PROVIDER=whisper

# Optional: Deepgram (if not using CometAPI Whisper)
LIFEOS_DEEPGRAM_API_KEY=

# Privacy defaults
LIFEOS_AUDIO_RETENTION_POLICY=after_transcription
LIFEOS_AUDIO_RETENTION_DAYS=30
LIFEOS_ENCRYPT_AT_REST=true

# Google Calendar (OAuth)
LIFEOS_GOOGLE_CALENDAR_CLIENT_ID=
LIFEOS_GOOGLE_CALENDAR_CLIENT_SECRET=
