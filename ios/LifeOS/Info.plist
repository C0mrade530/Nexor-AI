<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Nexor</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
		<key>UIImageName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>microphone</string>
		<string>armv7</string>
	</array>

	<!-- Permissions -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Nexor needs access to the microphone to record audio throughout your day, capturing meetings, ideas, and thoughts for AI processing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Nexor uses speech recognition to transcribe your recordings into text for event extraction and daily summaries.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Nexor can create calendar events from meetings and appointments detected in your conversations.</string>
	<key>NSContactsUsageDescription</key>
	<string>Nexor can match participants mentioned in conversations to your contacts.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Nexor can tag recordings with location to provide better context for your events.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Nexor reads your health data (sleep, steps, workouts, heart rate) to provide personalized energy and wellness recommendations.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Nexor can write mindful minutes from your recording sessions.</string>

	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>

	<!-- App Transport Security — allow local dev server -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
